# MOM text MVP
# Copy this file to .env and edit only what you need.

# Browser UI
MOM_HOST=127.0.0.1
MOM_PORT=8787

# OpenAI-compatible model endpoint.
# llama.cpp defaults to this local address.
MOM_API_BASE=http://127.0.0.1:8080/v1
MOM_API_KEY=

# Set this to the model ID/preset exposed by your endpoint.
# If left blank, MOM will try the first model returned by GET /v1/models.
MOM_MODEL=

MOM_TEMPERATURE=0.72
MOM_MAX_HISTORY=30

# Optional Supabase mirroring. If omitted, transcripts still persist locally.
SUPABASE_URL=
SUPABASE_KEY=
