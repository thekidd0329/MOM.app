{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mom://contracts/confirmed_fact.schema.json",
  "title": "MOM Confirmed Fact",
  "type": "object",
  "required": ["id", "user_id", "confirmed_at", "subject", "predicate", "value", "confirmation_source", "truth_state", "provenance"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "confirmed_at": {"type": "string", "format": "date-time"},
    "subject": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "value": {},
    "confirmation_source": {
      "type": "string",
      "enum": ["direct_user_statement", "user_confirmation", "user_correction"]
    },
    "truth_state": {"enum": ["confirmed", "stale", "superseded"]},
    "provenance": {
      "type": "object",
      "required": ["event_ids"],
      "properties": {
        "event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "candidate_id": {"type": ["string", "null"]},
        "conversation_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "importance": {"type": "number", "minimum": 0, "maximum": 1},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
