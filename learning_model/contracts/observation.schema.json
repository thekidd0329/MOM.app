{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mom://contracts/observation.schema.json",
  "title": "MOM Observation",
  "type": "object",
  "required": ["id", "user_id", "observed_at", "source_type", "source", "payload", "truth_state"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "source_type": {
      "type": "string",
      "enum": ["user_statement", "conversation", "location", "audio", "camera", "photo", "device", "calendar", "contact", "integration", "system", "other"]
    },
    "source": {"type": "string", "minLength": 1},
    "payload": {},
    "truth_state": {"const": "observed"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "sensitivity": {"type": "string", "enum": ["normal", "private", "sensitive"]},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
