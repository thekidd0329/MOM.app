{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mom://contracts/fact_candidate.schema.json",
  "title": "MOM Fact Candidate",
  "type": "object",
  "required": ["id", "user_id", "created_at", "subject", "predicate", "value", "source_observation_ids", "truth_state"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "subject": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "value": {},
    "source_observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "truth_state": {"const": "candidate"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confirmation_needed": {"type": "boolean", "default": true},
    "confirmation_question": {"type": ["string", "null"]},
    "memory_scope": {"type": "string", "enum": ["working", "short_term", "long_term"]},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
