{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mom://contracts/learning_event.schema.json",
  "title": "MOM Learning Event",
  "type": "object",
  "required": ["id", "user_id", "created_at", "event_type", "entity_id"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "event_type": {
      "type": "string",
      "enum": ["observation_recorded", "candidate_created", "confirmation_requested", "candidate_confirmed", "candidate_rejected", "fact_corrected", "fact_marked_stale", "fact_retrieved"]
    },
    "entity_id": {"type": "string", "minLength": 1},
    "conversation_id": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
