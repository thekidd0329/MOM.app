{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MOM behavior teaching example",
  "type": "object",
  "required": ["user_message", "ideal_response"],
  "properties": {
    "id": {"type": "string"},
    "topic": {"type": "string"},
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["user", "assistant"]},
          "content": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "known_context": {
      "type": "array",
      "items": {"type": "string"}
    },
    "user_message": {"type": "string", "minLength": 1},
    "ideal_response": {"type": "string", "minLength": 1},
    "emotion": {
      "type": "array",
      "items": {"type": "string"}
    },
    "maternal_intent": {"type": "string"},
    "bad_response": {"type": "string"},
    "failure_reason": {"type": "string"},
    "tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
